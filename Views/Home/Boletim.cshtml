@model Boletim_Notas.Models.BoletimViewModel

@{
    ViewData["Title"] = "Boletim Escolar";
}

<div class="container text-center mt-4">
    <h2 class="mb-4">Meu Boletim de Notas</h2>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th style="width: 40%;">Disciplina</th>
                <th style="width: 20%;">Nota</th>
                <th style="width: 20%;">Status</th>
                <th style="width: 20%;">Classificação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td class="text-start">@item.Disciplina</td>
                    <td class="fw-bold">@item.Nota.ToString("N1")</td>
                    <td style="@item.EstiloStatus">@item.Status</td>
                    <td class="fw-bold">@item.Classificacao</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-secondary fw-bold">
                <td class="text-center">Média Geral:</td>
                <td colspan="3" class="text-center">@Model.MediaGeral.ToString("N1")</td>
            </tr>
        </tfoot>
    </table>
</div>
